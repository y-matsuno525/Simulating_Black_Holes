  year      =  2020
}
@ARTICLE{Kinoshita2025,
  title     = "Spin systems as quantum simulators of quantum field theories in
               curved spacetimes",
  author    = "Kinoshita, Shunichiro and Murata, Keiju and Yamamoto, Daisuke
               and Yoshii, Ryosuke",
  abstract  = "We demonstrate that a quantum field theory (QFT) in general
               two-dimensional curved spacetimes can be realized by a system of
