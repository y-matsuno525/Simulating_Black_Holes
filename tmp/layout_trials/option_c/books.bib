@ARTICLE{Horner2023,
  title     = "Chiral spin-chain interfaces exhibiting event-horizon physics",
  author    = "Horner, Matthew D and Hallam, Andrew and Pachos, Jiannis K",
  abstract  = "The interface between different quantum phases of matter can
               give rise to novel physics, such as exotic topological phases or
               nonunitary conformal field theories. Here we investigate the
               interface between two spin chains in different chiral phases.
               Surprisingly, the mean field theory approximation of this
               interacting composite system is given in terms of Dirac fermions
               in a curved space-time geometry. In particular, the interface
